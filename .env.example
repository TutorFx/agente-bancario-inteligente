# Chave da API do Google Gemini (obrigatória com o modelo padrão)
# Também aceita GOOGLE_API_KEY. Se LLM_API_KEY estiver definida, ela tem prioridade sobre as duas.
GEMINI_API_KEY=sua_chave_gemini_aqui

# Opcionais: troca de modelo/provedor via LiteLLM (padrão: gemini/gemini-2.5-flash)
# Com LLM_BASE_URL apontando para um provedor local, a chave pode ser dispensada.
# LLM_MODEL_NAME=gemini/gemini-2.5-flash
# LLM_BASE_URL=
# LLM_API_KEY=

# Opcionais: guardrails via LLM
# Sem GUARDRAIL_MODEL_NAME, usa o modelo dos agentes (LLM_MODEL_NAME); abaixo, uma sugestão mais barata
# GUARDRAIL_MODEL_NAME=gemini/gemini-2.5-flash-lite
# Demais valores abaixo são os padrões
# GUARDRAIL_TIMEOUT_SEGUNDOS=5
# GUARDRAIL_AGENTES_SENSIVEIS=agente_credito,agente_entrevista_credito
# GUARDRAIL_FALHA_ENTRADA_SENSIVEL=fail_closed
# GUARDRAIL_FALHA_ENTRADA_GERAL=fail_open
# GUARDRAIL_FALHA_SAIDA=fail_closed
# GUARDRAIL_SAIDA_TEXTO_LONGO=500

# Opcionais: acesso à API do ADK (main.py)
# Com token, toda rota (exceto /health) exige "Authorization: Bearer <token>" ou "X-API-Key: <token>";
# o Streamlit envia o mesmo valor. Sem token, a API só aceita conexões locais (127.0.0.1/::1).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BANCO_AGIL_API_TOKEN=
# Interface de desenvolvimento do ADK em /dev-ui (padrão: desligada; não envia o token)
# BANCO_AGIL_DEV_UI=false

# Opcional: nível de log (DEBUG, INFO, WARNING, ERROR; padrão: INFO)
# LOG_LEVEL=INFO
