# Chave da API do Google Gemini (obrigatória)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Opcionais: troca de modelo/provedor via LiteLLM
# LLM_MODEL_NAME=gemini/gemini-2.5-flash
# LLM_BASE_URL=
# LLM_API_KEY=

# Opcionais: guardrails via LLM (valores padrão abaixo; sem GUARDRAIL_MODEL_NAME, usa o modelo dos agentes)
# GUARDRAIL_MODEL_NAME=gemini/gemini-2.5-flash-lite
# GUARDRAIL_TIMEOUT_SEGUNDOS=5
# GUARDRAIL_AGENTES_SENSIVEIS=agente_credito,agente_entrevista_credito
# GUARDRAIL_FALHA_ENTRADA_SENSIVEL=fail_closed
# GUARDRAIL_FALHA_ENTRADA_GERAL=fail_open
# GUARDRAIL_FALHA_SAIDA=fail_closed
# GUARDRAIL_SAIDA_TEXTO_LONGO=500
